#!/usr/bin/env bash
set -euo pipefail

TASK="${1:-system snapshot}"
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT_DIR="/home/openclaw/OpenClaw/exports/inspection-$STAMP"
mkdir -p "$OUT_DIR"

{
  echo "TASK: $TASK"
  echo "DATE: $(date)"
  echo "HOST: $(hostname)"
  echo
  echo "=== RUNNING CHIEF/OPENCLAW PROCESSES ==="
  ps -efww | grep -Ei "chief|openclaw|ollama" | grep -v grep || true
  echo
  echo "=== LISTENING PORTS ==="
  ss -ltnp 2>/dev/null || true
  echo
  echo "=== OLLAMA MODELS ==="
  ollama list 2>/dev/null || true
  echo
  echo "=== STARTUP SCRIPTS ==="
  ls -1 /home/openclaw/start_* 2>/dev/null || true
  echo
  echo "=== OPENCLAW TOP LEVEL ==="
  find /home/openclaw -maxdepth 1 -type f | sort
  echo
  echo "=== OPENCLAW RUNTIME DIRS ==="
  find /home/openclaw/OpenClaw -maxdepth 2 -type f 2>/dev/null | sort || true
  echo
  echo "=== BUILDER REPO TOP LEVEL ==="
  find /home/openclaw/openclaw-builder -maxdepth 2 \
    -path /home/openclaw/openclaw-builder/.git -prune -o \
    -path /home/openclaw/openclaw-builder/.venv -prune -o \
    -path /home/openclaw/openclaw-builder/node_modules -prune -o \
    -type f -print | sort
  echo
} | tee "$OUT_DIR/findings.txt"

cat > "$OUT_DIR/system-map.mmd" <<'MAP'
flowchart TD
  Telegram[Telegram]
  Listener[chief_listener.py]
  Worker[chief_worker.py]
  Queue[chief_queue.log]
  Reply[chief_reply_worker.py]
  State[chief_state_worker.py]
  Album[chief_album_brain.py]
  Billing[chief_billing_brain.py]
  Watcher[chief_watcher_brain.py]
  Sender[chief_sender.py]
  TGOut[Telegram Bot API]
  Builder[builder-task.sh / chief-build / chief-router]
  Ollama[Ollama]
  Repo[openclaw-builder]

  Telegram --> Listener
  Listener --> Worker
  Worker --> Queue
  Queue --> Reply
  Queue --> State
  Queue --> Album
  Queue --> Billing
  State --> Watcher
  Album --> Sender
  Billing --> Sender
  Reply --> Sender
  Watcher --> Sender
  Sender --> TGOut
  Builder --> Ollama
  Builder --> Repo
MAP

cat > "$OUT_DIR/system-map.md" <<MD
# Chief Read-Only Inspection Snapshot

## Task
$TASK

## Date
$(date)

## What this is
This is a read-only inspection snapshot generated locally.

## Mermaid diagram

\`\`\`mermaid
$(cat "$OUT_DIR/system-map.mmd")
\`\`\`

## Verified now
- Chief/OpenClaw processes were inspected from the live machine.
- Listening ports were inspected from the live machine.
- Installed Ollama models were inspected from the live machine.
- Startup scripts and top-level runtime files were listed from the live machine.

## Assumed
- Routing from queue to specialist brains is inferred from prior inspection and file roles.
- Exact process-to-port ownership beyond the process listing may still need tighter tracing.
- Some specialist behaviors may depend on files or logs not listed here.

## Next inspection targets
- Inspect queue consumers more precisely.
- Inspect startup coverage for billing/watcher brains.
- Inspect remaining env-var cleanup and secret handling.
- Decide where the builder layer should plug into live Chief.
MD

echo "Wrote inspection to: $OUT_DIR"
