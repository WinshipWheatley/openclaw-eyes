[Unit]
Description=Run the OpenClaw self-knowledge engine scheduled crawl every 15 minutes
Documentation=file://@REPO_ROOT@/Operator/CODEX-SELF-KNOWLEDGE-ENGINE-RESULT.md

[Timer]
OnBootSec=300
OnUnitActiveSec=900
AccuracySec=30
Persistent=false
Unit=self-knowledge-crawl.service

[Install]
WantedBy=timers.target
