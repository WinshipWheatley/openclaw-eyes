[Unit]
Description=OpenClaw Mission Control request/response bridge
Documentation=file://@REPO_ROOT@/OPENCLAW_RUNTIME.md
ConditionPathIsDirectory=/mnt/e/openclaw/mission_control_capture_requests/inbox
ConditionPathIsDirectory=/mnt/e/openclaw/mission_control_responses/to_mac

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env python3 @REPO_ROOT@/scripts/run_openclaw_request_response_service.py --watch-seconds 300 --poll-interval 1 --active-poll-interval 0.05 --active-window-seconds 180 --max-requests 100 --format summary
Restart=always
RestartSec=1
NoNewPrivileges=true

[Install]
WantedBy=openclaw-stack.target
