[Unit]
Description=OpenClaw autonomous invoice prep scheduler (prepare-only)
Documentation=file://@REPO_ROOT@/OPENCLAW_RUNTIME.md

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env python3 @REPO_ROOT@/autonomous_invoice_prep_scheduler.py --once
NoNewPrivileges=true
TimeoutStartSec=180
