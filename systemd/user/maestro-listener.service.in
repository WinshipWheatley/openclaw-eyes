[Unit]
Description=OpenClaw Maestro Listener
PartOf=openclaw-stack.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=OPENCLAW_MAESTRO_REPLY_ONLY=1
Restart=always
RestartSec=5
ExecStart=/bin/bash -lc 'mkdir -p /mnt/c/OpenClaw/logs && source @REPO_ROOT@/.chief.env && export OPENCLAW_MAESTRO_REPLY_ONLY=1 && exec @REPO_ROOT@/chief_env/bin/python -u @REPO_ROOT@/maestro_listener.py >> /mnt/c/OpenClaw/logs/maestro_listener.out 2>&1'

[Install]
WantedBy=openclaw-stack.target
