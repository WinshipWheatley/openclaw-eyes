[Unit]
Description=OpenClaw sleep/suspend resilience monitor
Documentation=file://@REPO_ROOT@/OPENCLAW_RUNTIME.md
After=openclaw-service-keeper.timer

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env python3 @REPO_ROOT@/scripts/run_openclaw_sleep_resilience.py --loop --interval-seconds 60 --active-window-seconds 900 --resume-gap-seconds 600 --apply-host-awake --run-service-keeper-on-resume --format summary
Restart=always
RestartSec=5
StandardOutput=append:%h/.local/state/openclaw/logs/openclaw-sleep-resilience.log
StandardError=append:%h/.local/state/openclaw/logs/openclaw-sleep-resilience.log
NoNewPrivileges=true

[Install]
WantedBy=openclaw-stack.target
