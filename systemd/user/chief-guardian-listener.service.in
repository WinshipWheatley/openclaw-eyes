[Unit]
Description=OpenClaw Guardian Approval Listener
PartOf=openclaw-stack.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecCondition=/bin/bash -lc 'source @REPO_ROOT@/.chief.env && test -n "$GUARDIAN_BOT_TOKEN"'
Restart=always
RestartSec=5
ExecStart=/bin/bash -lc 'mkdir -p /mnt/c/OpenClaw/logs && source @REPO_ROOT@/.chief.env && exec @REPO_ROOT@/chief_env/bin/python -u @REPO_ROOT@/chief_guardian_listener.py >> /mnt/c/OpenClaw/logs/guardian_listener.out 2>&1'

[Install]
WantedBy=openclaw-stack.target
