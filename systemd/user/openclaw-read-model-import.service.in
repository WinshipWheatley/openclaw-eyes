[Unit]
Description=OpenClaw read-model import agent
Documentation=file://@REPO_ROOT@/docs/operations/OPENCLAW_LOCAL_AUTOMATION_SERVICES_V0.md
ConditionPathExists=/mnt/e/openclaw

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ @REPO_ROOT@/scripts/pc_read_model_import_agent.py --once --format operator
