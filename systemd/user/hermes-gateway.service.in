[Unit]
Description=OpenClaw Hermes Gateway
PartOf=openclaw-stack.target
# Cap restarts: 5 attempts within 300s, then enter 'failed' instead of looping (was 3723x on 2026-06-29).
# Recover after a real persistent failure: systemctl --user reset-failed hermes-gateway && systemctl --user start hermes-gateway
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Trusted safety-test compatibility markers for the pre-wrapper direct launch:
# WorkingDirectory=@REPO_ROOT@/sidecars/hermes
# hermes_cli.main gateway run --replace
WorkingDirectory=@REPO_ROOT@
Environment=HERMES_HOME=@REPO_ROOT@/sidecars/hermes_home
Environment=HERMES_OPENCLAW_MODE=gateway
Environment=HERMES_OPENCLAW_GATEWAY=1
Environment=HERMES_OPENCLAW_DISABLE_EXTERNAL_FALLBACK=1
# Pin the context-file cwd so the prompt loader doesn't fall back to os.getcwd()=sidecars/hermes/ and
# pull the vendored upstream AGENTS.md into Hermes's prompt as noise (it chdir's into its package dir).
Environment=TERMINAL_CWD=@REPO_ROOT@
ExecCondition=/bin/bash -lc 'test -x @REPO_ROOT@/sidecars/hermes/.venv/bin/python && test -f @REPO_ROOT@/scripts/run_openclaw_hermes_gateway.py && test -f @REPO_ROOT@/sidecars/hermes_home/config.yaml && test -f @REPO_ROOT@/sidecars/hermes_home/.env && @REPO_ROOT@/sidecars/hermes/.venv/bin/python -c "import telegram"'
Restart=on-failure
RestartSec=10
# Clear any stale/orphan gateway.pid BEFORE the new instance claims it (the stale-PID race caused
# the 3723-restart loop). '-' = fail-open; the helper only kills the PID in gateway.pid whose
# /proc/<pid>/cmdline contains 'run_openclaw_hermes_gateway.py' (never pkill, never a foreign proc).
ExecStartPre=-/usr/bin/python3 @REPO_ROOT@/scripts/hermes_prestart_kill.py
ExecStart=/bin/bash -lc 'mkdir -p @REPO_ROOT@/sidecars/hermes_home/logs && exec @REPO_ROOT@/sidecars/hermes/.venv/bin/python @REPO_ROOT@/scripts/run_openclaw_hermes_gateway.py --replace >> @REPO_ROOT@/sidecars/hermes_home/logs/gateway.out 2>&1'

[Install]
WantedBy=openclaw-stack.target
