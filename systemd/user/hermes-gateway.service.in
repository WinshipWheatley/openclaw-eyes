[Unit]
Description=OpenClaw Hermes Gateway
PartOf=openclaw-stack.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@/sidecars/hermes
Environment=HERMES_HOME=@REPO_ROOT@/sidecars/hermes_home
ExecCondition=/bin/bash -lc 'test -x @REPO_ROOT@/sidecars/hermes/.venv/bin/python && test -f @REPO_ROOT@/sidecars/hermes_home/config.yaml && test -f @REPO_ROOT@/sidecars/hermes_home/.env && @REPO_ROOT@/sidecars/hermes/.venv/bin/python -c "import telegram"'
Restart=on-failure
RestartSec=10
ExecStart=/bin/bash -lc 'mkdir -p @REPO_ROOT@/sidecars/hermes_home/logs && exec @REPO_ROOT@/sidecars/hermes/.venv/bin/python -m hermes_cli.main gateway run --replace >> @REPO_ROOT@/sidecars/hermes_home/logs/gateway.out 2>&1'

[Install]
WantedBy=openclaw-stack.target
