# Group 2 — billing_mode_from_text disambiguation table
# ---------------------------------------------------------------------------

@pytest.mark.parametrize("text,expected_mode", [
    # INVOICE signals
    ("I need to send an invoice", "INVOICE"),
    ("create invoice for DJ set", "INVOICE"),
    ("make an invoice", "INVOICE"),
    ("draft invoice for the event", "INVOICE"),
    # PAYMENT signals
    ("payment received from venue", "PAYMENT"),
    ("got paid today", "PAYMENT"),
    ("deposit received for the gig", "PAYMENT"),
    ("mark payment received", "PAYMENT"),
    # FOLLOWUP signals — must not contain "payment" or "invoice" (those keywords
    # shadow followup because INVOICE and PAYMENT blocks are checked first)
    ("follow up with the client", "FOLLOWUP"),
    ("follow-up with the venue next week", "FOLLOWUP"),
    ("nudge the client about the balance", "FOLLOWUP"),
    # RECEIPT signals — must not contain "invoice" (INVOICE block fires first)
    ("issue receipt for the booking", "RECEIPT"),
    ("send receipt to client", "RECEIPT"),
    # None — unrelated
    ("what did i make this month", None),
    ("restart stack", None),
    ("send email to mike", None),
])
def test_billing_mode_from_text_table(text: str, expected_mode: str | None) -> None:
    assert billing_mode_from_text(text) == expected_mode


# ---------------------------------------------------------------------------
# Group 3 — routing precedence (route_message end-to-end)
# ---------------------------------------------------------------------------

@pytest.mark.parametrize("text,expected_intent", [
    # Stack restart takes highest priority
    ("restart stack", "stack_restart"),
    ("restart the stack", "stack_restart"),
    # Cancel is high priority
    ("cancel", "cancel"),
    # CPA-level
    ("what did i make", "cpa_query"),
    ("log expense", "cpa_query"),
    # Billing mode
    ("I need to send an invoice", "billing_start"),
    # Brainstorm
    ("brainstorm new single concept", "brainstorm_capture"),
])
def test_routing_precedence_table(
    monkeypatch: pytest.MonkeyPatch,
    text: str,
    expected_intent: str,
) -> None:
    monkeypatch.setitem(route_message.__globals__, "_log_route", lambda *args, **kwargs: None)
    monkeypatch.setitem(route_message.__globals__, "append_history", lambda *args, **kwargs: None)
    monkeypatch.setitem(route_message.__globals__, "set_workflow", lambda *args, **kwargs: None)
    monkeypatch.setitem(route_message.__globals__, "set_workflow_state", lambda *args, **kwargs: None)
    monkeypatch.setitem(route_message.__globals__, "reset_session", lambda: None)
    monkeypatch.setitem(route_message.__globals__, "mark_cancelled", lambda: None)
    monkeypatch.setitem(route_message.__globals__, "cpa_handle", lambda _: ["stub cpa"])
    monkeypatch.setitem(route_message.__globals__, "brainstorm_handle", lambda _: ["stub brainstorm"])

    class _NoopThread:
        def __init__(self, target=None, daemon=None):
            self.target = target
            self.daemon = daemon

        def start(self) -> None:
            return None

    monkeypatch.setitem(
        sys.modules,
        "subprocess",
        types.SimpleNamespace(Popen=lambda *args, **kwargs: None, STDOUT=-1),
    )
    monkeypatch.setitem(
        sys.modules,
        "threading",
        types.SimpleNamespace(Thread=_NoopThread),
    )

    result = route_message(text)
    assert result["intent"] == expected_intent, (
        f"route_message({text!r}) returned intent={result['intent']!r}, "
        f"expected {expected_intent!r}"
    )
