    {
      "evidence_category": "doctrine_or_system_map",
      "evidence_label": "doctrine_excerpt",
      "excerpt": "1) Single Source of Truth",
      "excerpt_char_count": 25,
      "heading": "1) Single Source of Truth",
      "line_number": 11,
      "markdown_evidence_item_id": "mdeitem_13183f976badde8fb295",
